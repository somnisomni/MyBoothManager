{
  "name": "@myboothmanager/common",
  "version": "0.8.2",
  "author": "somni <me@somni.one>",
  "packageManager": "pnpm@10.33.0",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "scripts": {
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc -p tsconfig.build.esm.json && tsc-alias -p tsconfig.build.esm.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json && tsc-alias -p tsconfig.build.cjs.json",
    "clean": "rimraf ./dist",
    "lint": "eslint .",
    "test": "jest"
  },
  "files": [
    "./dist"
  ],
  "devDependencies": {
    "@myboothmanager/dev-shared": "workspace:^",
    "@tsconfig/node20": "^20.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.12.0",
    "eslint": "^10.1.0",
    "execa": "^9.6.1",
    "jest": "^30.3.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "tsc-alias": "^1.8.16"
  },
  "dependencies": {
    "currency-symbol-map": "^5.1.0",
    "dompurify": "^3.3.3",
    "marked": "^17.0.5",
    "simple-icons": "^14.2.0"
  }
}
