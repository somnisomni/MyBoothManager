{
  "name": "@myboothmanager/common-ui",
  "version": "0.9.0",
  "author": "somni <me@somni.one>",
  "packageManager": "pnpm@9.15.9",
  "license": "PolyForm-Strict-1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm clean && run-p type-check \"build-only {@}\" --",
    "clean": "rimraf ./dist",
    "build-only": "vite build && vue-tsc -p tsconfig.app.json --declaration --emitDeclarationOnly",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint ."
  },
  "files": [
    "./dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/common-ui.js",
  "module": "./dist/common-ui.js",
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@myboothmanager/common": "workspace:^",
    "@myboothmanager/dev-shared": "workspace:^",
    "@tsconfig/node20": "^20.1.9",
    "@types/clone-deep": "^4.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "sass-embedded": "^1.98.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "=3.5.30",
    "vue-facing-decorator": "^4.0.1",
    "vue-tsc": "^3.2.6",
    "vuetify": "^3.12.4"
  },
  "peerDependencies": {
    "@mdi/font": ">=7",
    "@myboothmanager/common": "*",
    "vue": ">=3",
    "vue-facing-decorator": ">=3",
    "vuetify": ">=3 <4"
  },
  "dependencies": {
    "clone-deep": "^4.0.1"
  }
}
