{
  "name": "@myboothmanager/backend",
  "version": "0.9.0",
  "author": "somni <me@somni.one>",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "license": "PolyForm-Strict-1.0.0",
  "scripts": {
    "__run": "cross-env NODE_OPTIONS=\"--import tsx/esm\" NODE_ENV=development",
    "__run:prod": "cross-env NODE_OPTIONS=\"--import tsx/esm\" NODE_ENV=production",
    "build": "nest build",
    "start": "pnpm __run nest start",
    "start:prod": "pnpm __run:prod node dist/src/main",
    "start:dev": "pnpm start --watch --preserveWatchOutput",
    "start:debug": "pnpm start --debug --watch",
    "migrate": "cross-env NODE_ENV=development ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/db-migrator/migrate",
    "migrate:prod": "pnpm __run:prod node dist/scripts/db-migrator/migrate",
    "seed": "cross-env NODE_ENV=development ts-node -P tsconfig.scripts.json -r tsconfig-paths/register scripts/db-migrator/seed",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "test": "jest",
    "test:watch": "pnpm test --watch",
    "test:cov": "pnpm test --coverage"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "tsx": "^4.21.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@myboothmanager/common": "workspace:^",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/platform-fastify": "^11.1.17",
    "app-root-path": "^3.1.0",
    "argon2": "^0.44.0",
    "chalk": "^4",
    "class-validator": "^0.15.1",
    "class-transformer": "^0.5.1",
    "clone-deep": "^4.0.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "fastify": "=5.8.2",
    "luxon": "^3.7.2",
    "mysql2": "^3.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.34.5",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@myboothmanager/dev-shared": "workspace:^",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@tsconfig/node20": "^20.1.9",
    "@types/clone-deep": "^4.0.4",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.12.0",
    "@types/sequelize": "^6.12.0",
    "@types/validator": "^13.15.10",
    "eslint": "^10.1.0",
    "expect-type": "^1.3.0",
    "jest": "^30.3.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
